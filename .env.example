# ============================================================
# Cấu hình môi trường - NHÀ HÀNG AN PHÚC (Restaurant Order Management)
# Sao chép file này thành .env và điền giá trị thật.
# .env KHÔNG được commit lên git.
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=restaurant_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=thay_bang_mat_khau_manh_cua_ban
# Tài khoản ứng dụng (least-privilege, tạo bởi database/init.sh)
APP_DB_USER=appuser
APP_DB_PASSWORD=thay_bang_mat_khau_manh_cua_ban

# Cổng host để truy cập PostgreSQL từ máy (chỉ bind 127.0.0.1, chỉ để kiểm tra)
POSTGRES_HOST_PORT=5434

# ---------- pgAdmin ----------
# Lưu ý: dùng domain hợp lệ (tránh .local - pgAdmin từ chối TLD đặc biệt)
PGADMIN_DEFAULT_EMAIL=admin@nhahang.com
PGADMIN_DEFAULT_PASSWORD=thay_bang_mat_khau_manh_cua_ban
PGADMIN_HOST_PORT=5051

# ---------- Backend (JWT) ----------
JWT_SECRET=thay_bang_chuoi_bi_mat_ngau_nhien

# ---------- Grafana ----------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=thay_bang_mat_khau_manh_cua_ban
